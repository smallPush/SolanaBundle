{% extends 'base.html.twig' %}

{% block title %}Nuevo Contrato de Solana{% endblock %}

{% block body %}
    <h1>Crear Nuevo Contrato</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-success">{{ button_label|default('Guardar') }}</button>
    {{ form_end(form) }}

    <a href="{{ path('app_solana_contract_index') }}" class="btn btn-link mt-3">Volver a la lista</a>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '_autocomplete_script.html.twig' %}
{% endblock %}
