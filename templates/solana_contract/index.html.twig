{% extends 'base.html.twig' %}

{% block title %}Contratos de Solana{% endblock %}

{% block body %}
    <h1>Contratos de Solana</h1>
    <a href="{{ path('app_solana_contract_new') }}" class="btn btn-primary mb-3">Crear Nuevo Contrato</a>

    <table class="table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for contract in contracts.items %}
            <tr>
                <td>{{ contract.title }}</td>
                <td>{{ contract.status }}</td>
                <td>
                    <a href="{{ path('app_solana_contract_show', {'id': contract.id}) }}" class="btn btn-sm btn-info">Ver</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">No se encontraron contratos.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if contracts.pages > 1 %}
        <nav aria-label="Page navigation">
            <ul class="pagination">
                {% if contracts.page > 1 %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('app_solana_contract_index', {page: contracts.page - 1}) }}">Anterior</a>
                    </li>
                {% endif %}

                {% for i in 1..contracts.pages %}
                    <li class="page-item {{ i == contracts.page ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('app_solana_contract_index', {page: i}) }}">{{ i }}</a>
                    </li>
                {% endfor %}

                {% if contracts.page < contracts.pages %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('app_solana_contract_index', {page: contracts.page + 1}) }}">Siguiente</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
